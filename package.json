{
  "name": "clipforge-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ClipForge AI - turn long videos and podcasts into short-form social clips.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
