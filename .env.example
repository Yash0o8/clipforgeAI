# ---------------------------------------------------------------------------
# ClipForge AI - environment configuration
# Copy this file to `.env` and adjust. Never commit real secrets.
# All variables are prefixed with VITE_ so Vite exposes them to the client.
# NOTE: anything in a VITE_ variable ships inside the browser bundle.
#       Keep API secrets server-side; only public values belong here.
# ---------------------------------------------------------------------------

# Base URL of the ClipForge FastAPI backend.
#
# Either form works; the prefix is stripped and re-applied by src/services/api.js
# so `/api/v1/api/v1` cannot happen:
#   http://localhost:8000
#   http://localhost:8000/api/v1
#
# Leave empty to call the same origin the app is served from (useful behind a
# reverse proxy that mounts the API on the same host).
VITE_API_BASE_URL=http://localhost:8000

# Prefix for REST routes. Must match the backend's router prefix.
VITE_API_PREFIX=/api/v1

# Request timeout for JSON API calls, in milliseconds.
# Upload part transfers and file downloads use their own, longer budgets.
VITE_API_TIMEOUT=30000

# Max upload size accepted by the client-side validator, in megabytes.
# Keep in sync with the server-side limit.
VITE_MAX_UPLOAD_MB=2048

# Accepted upload container/extension list (comma separated, no dots).
VITE_ACCEPTED_VIDEO_TYPES=mp4,mov,webm,m4v