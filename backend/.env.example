# ClipForge backend configuration
# Copy to backend/.env and fill values as needed.

# --- Server ---
# HOST=127.0.0.1
# PORT=8000
# API_PREFIX=/api/v1
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage / media ---
# DATA_DIR=
# MAX_UPLOAD_MB=2048
# FFMPEG_BINARY=ffmpeg
# FFPROBE_BINARY=ffprobe

# --- Transcription ---
# WHISPER_MODEL=small
# WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_LANGUAGE=
# TRANSCRIPTION_HINT=auto

# --- Optional free/low-cost LLM ranking (improves highlight selection) ---
# Groq has a free tier and OpenAI-compatible API. Recommended for quick setup.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter supports free models/routes (availability varies by model/provider).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Other optional providers:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# QWEN_API_KEY=
# QWEN_MODEL=qwen2.5-7b-instruct
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- Optional mode features (best-effort; install optional deps) ---
# Face tracking prefers MediaPipe and falls back to OpenCV's bundled Haar cascade.
# ENABLE_FACE_TRACKING=true
# Audio analysis decodes video audio to WAV with ffmpeg before using librosa.
# ENABLE_AUDIO_SPIKE_DETECTION=true
# ENABLE_SCENE_CUT_DETECTION=true
# ENABLE_DEAD_AIR_REMOVAL=true
# ENABLE_SFX_HOOKS=false  # when true and export requests sfxEnabled, render mixes short marker tones

# --- Queue / demo limits / entitlements ---
# JOB_QUEUE=inline
# REDIS_URL=redis://127.0.0.1:6379/0
# ENABLE_DEMO_LIMITS=false
# DEMO_MAX_PROJECTS=3
# DEMO_MAX_EXPORTS_PER_DAY=10
# FREE_WATERMARK_TEXT=ClipForge Free
# ALLOW_1080P60_EXPORTS=false
